{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kiri",
  "version": "1.1.0",
  "identifier": "io.yuxino.kiri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "library",
        "title": "kiri",
        "width": 960,
        "height": 640,
        "minWidth": 820,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A fast, local-first capture workspace",
    "longDescription": "Capture screenshots, annotate, recognize text, record regions, and keep everything in a local library. No cloud required.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": null
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "binaries/ffmpeg-current/": "ffmpeg-current/"
    }
  }
}
