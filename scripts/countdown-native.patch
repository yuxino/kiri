+        emit_recording_state(&app, &recording);
+        abandoned
+    };
+    let return_pid = abandoned.return_pid;
+    let was_kiri_frontmost = abandoned.was_kiri_frontmost;
+    cleanup_abandoned_recording(&app, abandoned);
